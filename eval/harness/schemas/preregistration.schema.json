{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.invalid/eval/schemas/preregistration.schema.json",
  "title": "Cadence factory eval: the preregistration record",
  "description": "sha256 of every input that decides the result. A live session starts only when the current hashes equal these.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "decision_rule_version", "hashes"],
  "properties": {
    "schema": {"const": "cadence-eval.preregistration/1"},
    "created_at": {"type": "string"},
    "decision_rule_version": {"type": "string", "pattern": "^[0-9]+$"},
    "hashes": {
      "type": "object",
      "required": ["config", "tickets", "replies", "reviewer", "stubs", "checks", "detectors",
                   "expectations", "pieces", "harness", "cadence_sha", "model", "claude_code_version"],
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40,64}$|^[A-Za-z0-9._:\\[\\]-]{1,100}$"}
    }
  }
}
