{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.invalid/eval/schemas/ticket.schema.json",
  "title": "Cadence factory eval: one ticket's front matter",
  "description": "The YAML front matter of tickets/<repo>-<n>.md. The body after the front matter is the issue body, verbatim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "issue", "title"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}\\.T[1-9][0-9]?$"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "issue": {"type": "integer", "minimum": 1, "maximum": 99},
    "title": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f]+$"}
  }
}
